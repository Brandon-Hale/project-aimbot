# Normalize line endings: LF in the repo and in the working tree on all
# platforms. Keeps diffs clean when the project is cloned on Linux/macOS.
* text=auto eol=lf

# Windows-only scripts must keep CRLF to run correctly.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never munge these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp4 binary
*.avi binary
*.mkv binary
*.mov binary
*.pt binary
*.onnx binary
*.engine binary
